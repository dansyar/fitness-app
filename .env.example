# Database — local dev uses SQLite. For Vercel, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Vercel Postgres.
DATABASE_URL="file:./dev.db"

# Anthropic — required for /api/analyze-meal and /api/generate-meal-plan
ANTHROPIC_API_KEY=

# NextAuth — generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links — any SMTP URL works (Resend, SendGrid, Mailtrap...)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Fitness App <noreply@example.com>

# Vercel Blob — for meal photo uploads
BLOB_READ_WRITE_TOKEN=
